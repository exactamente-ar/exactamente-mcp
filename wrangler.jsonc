{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "exactamente-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2025-05-29",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "vars": {
    "EXACTAMENTE_API_BASE_URL": "https://api.exactamente.com.ar",
  },
  // Rate limiting por IP de /mcp (src/lib/rateLimit.ts). 300 requests por minuto
  // por IP y por location de Cloudflare. `period` solo acepta 10 o 60 y tiene
  // que coincidir con RATE_LIMIT_PERIOD_SECONDS. `namespace_id` es único en la
  // cuenta: otro Worker con el mismo id compartiría contadores.
  "ratelimits": [
    {
      "name": "MCP_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 300, "period": 60 },
    },
  ],
  "routes": [{ "pattern": "mcp.exactamente.com.ar", "custom_domain": true }],
}
