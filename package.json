{
  "name": "exactamente-mcp",
  "version": "0.1.0",
  "description": "Read-only xmcp MCP server for Exactamente public academic data",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "prepare": "lefthook install || true",
    "build": "xmcp build",
    "build:cf": "xmcp build --cf",
    "dev": "xmcp dev",
    "dev:cf": "xmcp dev --cf",
    "deploy": "pnpm build:cf && wrangler deploy",
    "deploy:secret": "wrangler secret put OPENAI_APPS_VERIFICATION_TOKEN",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start-http": "node dist/http.js",
    "start-stdio": "node dist/stdio.js"
  },
  "dependencies": {
    "xmcp": "^0.6.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260530.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.95.0"
  },
  "main": "./dist/stdio.js",
  "files": [
    "dist"
  ],
  "bin": {
    "exactamente-mcp": "./dist/stdio.js"
  }
}
